# VoiceTerm hub configuration. Every value here is optional.
# This file is loaded by the systemd unit (EnvironmentFile) or by hand:
#   set -a; . ~/.config/voice-hub/env; set +a; node hub/server.js

# ---- phone side ----
HUB_PORT=8097
HUB_BIND=0.0.0.0
# Default device id used in session keys (two phones sharing a context use the same id).
HUB_DEVICE=dev01

# ---- cc-connect bridge ----
# Token file is written by deploy/install.sh (mode 600). Do not inline secrets here.
BRIDGE_URL=ws://127.0.0.1:9810/bridge/ws
# BRIDGE_TOKEN_FILE=/home/you/.config/voice-hub/bridge-token

# Extra cc-connect upstreams on other machines (JSON array). "agents" limits which
# agent ids that upstream owns; omit it to allow any.
# HUB_BRIDGES=[{"name":"box2","url":"ws://10.0.0.31:9811/bridge/ws","tokenFile":"/home/you/.config/voice-hub/bridge-token-2","agents":["pi"]}]

# Agents to expose. Empty = read cc-connect's config.toml projects automatically.
# HUB_AGENTS=claude,codex,opencode

# ---- speech (optional, OpenAI-compatible) ----
GATEWAY_URL=http://127.0.0.1:8080
# TTS_MODEL=mimo-v2.5-tts
# ASR_MODEL=mimo-v2.5-asr
# TTS_VOICE=alloy
# Local whisper fallback, used when the gateway is unreachable:
# WHISPER_URL=http://127.0.0.1:19980

# ---- optional direct CLI agent (no cc-connect project needed) ----
# HERMES_BIN=hermes
# HERMES_CWD=/home/you
# HERMES_DISABLE=1
